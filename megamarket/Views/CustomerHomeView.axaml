<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:megamarket.ViewModels"
             xmlns:models="using:megamarket.Models"
             x:Class="megamarket.Views.CustomerHomeView"
             x:DataType="vm:CustomerHomeViewModel"
             Background="#F5F6FA">

    <Grid ColumnDefinitions="260, *">
        
        
        <Border Grid.Column="0" Background="White" BorderBrush="#E1E3E8" BorderThickness="0,0,1,0" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="20">
                    <TextBlock Text="МегаМаркет" FontSize="24" FontWeight="Black" Foreground="#005BFF"/>
                    
                    <StackPanel Spacing="8">
                        <Button Content="🛒 Корзина" Command="{Binding OpenCartCommand}" Background="#F0F4FF" Foreground="#005BFF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="15,10" FontWeight="SemiBold"/>
                        <Button Content="👤 Личный кабинет" Command="{Binding OpenProfileCommand}" Background="#F0F4FF" Foreground="#005BFF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8" Padding="15,10" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Выйти" Command="{Binding LogoutCommand}" Background="Transparent" BorderBrush="#FF4D4D" BorderThickness="1" Foreground="#FF4D4D" CornerRadius="6" HorizontalAlignment="Stretch"/>

                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="КАТЕГОРИИ" FontSize="12" Foreground="#7F8C8D" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <TextBlock Text="{Binding Name}" Padding="5,8" Foreground="#2C3E50" FontSize="14"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        
        <ScrollViewer Grid.Column="1" Padding="30">
            <StackPanel Spacing="20">
                
                
                <Border Background="White" Padding="15" CornerRadius="8" BoxShadow="0 2 10 0 #10000000">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Поиск товаров..." Margin="0,0,10,0" CornerRadius="6" Padding="10"/>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding ApplyFiltersCommand}" Background="#005BFF" Foreground="White" CornerRadius="6" Margin="0,0,5,0"/>
                        <Button Grid.Column="2" Content="Сброс" Command="{Binding ClearFiltersCommand}" Background="#ECF0F1" Foreground="#2C3E50" CornerRadius="6"/>
                    </Grid>
                </Border>

                <TextBlock Text="Рекомендуем" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                
                
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="20" LineSpacing="20"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border Width="230" Height="340" Background="White" CornerRadius="12" BoxShadow="0 4 15 0 #15000000" Padding="15">
                                <Grid RowDefinitions="150, *, Auto, Auto">
                                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8">
                                        <TextBlock Text="{Binding Categoryid, Converter={x:Static vm:CategoryIconConverter.Instance}}" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Spacing="5" Margin="0,10">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50" TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock Text="{Binding Seller.Companyname}" FontSize="12" Foreground="#7F8C8D"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding Baseprice, StringFormat='{}{0:C0}'}" FontSize="20" FontWeight="Black" Foreground="#005BFF" Margin="0,0,0,10"/>
                                    <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Grid.Column="0" Content="Детали" Command="{Binding $parent[ItemsControl].((vm:CustomerHomeViewModel)DataContext).OpenProductCommand}" CommandParameter="{Binding}" Background="#E6F0FF" Foreground="#005BFF" CornerRadius="6"/>
                                        <Button Grid.Column="1" Content="В корзину" Command="{Binding $parent[ItemsControl].((vm:CustomerHomeViewModel)DataContext).AddToCartCommand}" CommandParameter="{Binding}" Background="#005BFF" Foreground="White" CornerRadius="6"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>