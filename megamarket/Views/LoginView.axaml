<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:megamarket.ViewModels"
             xmlns:conv="using:megamarket.Converters"
             x:Class="megamarket.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="#F0F4FF"> 

    <Border Background="White" CornerRadius="12" BoxShadow="0 10 25 0 #15000000" 
            Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
        
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">
            
            
            <TabItem Header="Вход" FontSize="16" FontWeight="Bold" Foreground="#005BFF" Padding="20,10">
                <StackPanel Spacing="15" Margin="0,20,0,0">
                    <TextBlock Text="МегаМаркет" FontSize="28" FontWeight="Black" Foreground="#005BFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Email" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox Text="{Binding Email}" Watermark="ivanov@mail.ru" CornerRadius="6" Padding="10"/>
                    
                    <TextBlock Text="Пароль" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox Text="{Binding Password}" Watermark="••••••••" PasswordChar="•" CornerRadius="6" Padding="10"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF4D4D" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10"/>

                    <Button Content="Войти" Command="{Binding LoginCommand}" 
                            Background="#005BFF" Foreground="White" FontWeight="Bold" 
                            HorizontalAlignment="Stretch" Height="45" CornerRadius="6" FontSize="16"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </TabItem>

            
            <TabItem Header="Регистрация" FontSize="16" FontWeight="Bold" Foreground="#005BFF" Padding="20,10">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,20,0,0">
                        
                        <TextBox Text="{Binding Email}" Watermark="Email" CornerRadius="6" Padding="10"/>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding FirstName}" Watermark="Имя" CornerRadius="6" Padding="10"/>
                            <TextBox Grid.Column="1" Text="{Binding LastName}" Watermark="Фамилия" CornerRadius="6" Padding="10"/>
                        </Grid>
                        <TextBox Text="{Binding Password}" Watermark="Пароль" PasswordChar="•" CornerRadius="6" Padding="10"/>
                        <TextBox Text="{Binding Phone}" Watermark="+7 (999) 999-99-99" CornerRadius="6" Padding="10"/>

                        <CheckBox Content="Я хочу продавать" IsChecked="{Binding IsSellerMode}" Foreground="#2C3E50" FontWeight="SemiBold"/>

                        <Border IsVisible="{Binding IsSellerMode}" Background="#F8F9FA" Padding="12" CornerRadius="6" BorderBrush="#E1E3E8" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Данные организации" FontWeight="Bold" FontSize="12"/>
                                <TextBox Text="{Binding Inn}" Watermark="ИНН" CornerRadius="4"/>
                                <Button Content="Проверить ИНН" Command="{Binding SendInnToCheckCommand}" Background="#E6F0FF" Foreground="#005BFF" Height="30" CornerRadius="4"/>
                                <TextBlock Text="{Binding InnStatus}" FontSize="11" Foreground="#28A745"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Background="#E1E3E8" Padding="15,10" CornerRadius="6">
                                <TextBlock Text="{Binding CaptchaText}" FontWeight="Bold" Foreground="#2C3E50"/>
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding CaptchaInput}" Watermark="Капча" CornerRadius="6" Padding="10"/>
                            <Button Grid.Column="2" Content="↻" Command="{Binding RefreshCaptchaCommand}" Background="#E6F0FF" Foreground="#005BFF" Width="40" CornerRadius="6"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FF4D4D" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" Background="#005BFF" Foreground="White" Height="45" CornerRadius="6" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>