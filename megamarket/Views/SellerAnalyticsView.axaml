<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:megamarket.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="megamarket.Views.SellerAnalyticsView"
             x:DataType="vm:SellerAnalyticsViewModel"
             Background="#F5F6FA">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#E1E3E8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <TextBlock Grid.Column="0" Text="{Binding SellerName, StringFormat='Аналитика: {0}'}" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <Button Grid.Column="2" Content="📦 На склад" Command="{Binding GoToWarehouseCommand}" Background="#E6F0FF" Foreground="#005BFF" FontWeight="SemiBold" Padding="15,5" CornerRadius="6" Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="Выйти" Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" Foreground="#FF4D4D" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="30">
            <StackPanel Spacing="20" MaxWidth="1000">
                
                <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BoxShadow="0 2 10 0 #10000000">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Общая выручка" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:C0}'}" FontSize="28" FontWeight="Bold" Foreground="#005BFF"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BoxShadow="0 2 10 0 #10000000">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Количество заказов" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalOrders}" FontSize="28" FontWeight="Bold" Foreground="#28A745"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="10" Padding="20" BoxShadow="0 2 10 0 #10000000">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Динамика продаж (7 дней)" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <lvc:CartesianChart Series="{Binding RevenueSeries}" XAxes="{Binding XAxes}" Height="300"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="20" BoxShadow="0 2 10 0 #10000000">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Топ-5 товаров" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <lvc:CartesianChart Series="{Binding TopProductsSeries}" YAxes="{Binding TopProductsYAxes}" Height="300" Margin="80,0,20,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>